<!DOCTYPE html>
<html lang="pt-br">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Aventura Cautelosa</title>
<style>
body{margin:0;background:#0a0a0a;color:#fff;font-family:monospace;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:100vh}
#screen_container{border:2px solid #333;width:800px;max-width:95vw;height:600px;background:#000}
#screen_container canvas{display:block}
h1{margin:10px}
</style>
</head>
<body>
<h1>AVENTURA CAUTELOSA - VM</h1>
<div id="screen_container"></div>
<div id="terminal" style="margin-top:10px; color:#0f0;"></div>

<script src="V86/libv86.js"></script>
<script>
var emulator = new V86({
    screen_container: document.getElementById("screen_container"),
    bios: { url: "V86/seabios.bin" },
    vga_bios: { url: "V86/vgabios.bin" },
    bzimage: { url: "V86/bzimage" },
    initrd: { url: "V86/initrd" },
    filesystem: {},
    autostart: true,
    memory_size: 128 * 1024 * 1024,
});
emulator.add_listener("emulator-ready", function(){ 
    document.getElementById("terminal").innerText = "VM carregada! Bootando...";
});
</script>
</body>
</html>
